{
  "name": "coffee-ahk",
  "version": "0.0.99",
  "description": "coffeescript -> ahk",
  "keywords": [
    "ahk",
    "auto hotkey",
    "coffeescript",
    "javascript",
    "typescript"
  ],
  "homepage": "https://github.com/phonowell/coffee-ahk",
  "bugs": {
    "url": "https://github.com/phonowell/coffee-ahk/issues"
  },
  "license": "MIT",
  "author": "Mimiko Phonowell <phnonwell@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/phonowell/coffee-ahk.git"
  },
  "files": [
    "dist/**",
    "README.md",
    "USAGE.md",
    "license.md",
    "docs/**/*.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm task build",
    "fmt": "oxfmt",
    "lint": "oxlint src tasks tests && oxfmt --check",
    "task": "tsx tasks/index.ts",
    "test": "pnpm task test",
    "watch": "pnpm task watch"
  },
  "dependencies": {
    "coffeescript": "^2.7.0",
    "fire-keeper": "^0.0.239",
    "iconv-lite": "^0.7.3",
    "radash": "^12.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "url": "https://github.com/phonowell/coffee-ahk"
}
